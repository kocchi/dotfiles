{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Internal schema for the fresh reviewer model response.",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposals", "rejected_count", "review_status"],
  "properties": {
    "proposals": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "problem", "evidence_count", "target", "proposal", "expected_effect", "cost", "confidence", "session_refs", "review_condition"],
        "properties": {
          "operation": {"enum": ["add", "subtract", "merge", "split", "none"]},
          "problem": {"type": "string", "maxLength": 300},
          "evidence_count": {"type": "integer", "minimum": 1},
          "target": {"enum": ["global_rule", "repo_rule", "skill", "hook", "tool", "none"]},
          "proposal": {"type": "string", "maxLength": 300},
          "expected_effect": {"type": "string", "maxLength": 300},
          "cost": {"type": "string", "maxLength": 300},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "session_refs": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "maxLength": 80}},
          "review_condition": {"type": "string", "maxLength": 300}
        }
      }
    },
    "rejected_count": {"type": "integer", "minimum": 0},
    "review_status": {"enum": ["pass", "partial", "reject"]}
  }
}
